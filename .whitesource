{
  "scanSettings": {
    "configMode": "LOCAL",
    "enableReachability": true,
    "configExclusions": [
      "**/test_inputs/**",
      "**/test_data/**"
    ]
  },
  "checkRunSettings": {
    "vulnerableCheckRunConclusionLevel": "failure",
    "displayMode": "diff",
    "useMendCheckNames": true
  },
  "issueSettings": {
    "minSeverityLevel": "LOW",
    "issueType": "VULNERABILITY"
  },
  "remediateSettings": {
    "enableRenovate": true,
    "extends": ["config:base"],
    "ignorePaths": [
      "**/test_inputs/**",
      "**/test_data/**"
    ]
  }
}

